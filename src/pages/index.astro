---
import '@fontsource-variable/inter';
import 'thira-ui/styles.css';
import { HeroCta } from '../components/HeroCta';
import { ThiraUiDemo } from '../components/ThiraUiDemo';
import { ExplodedStack } from '../components/ExplodedStack';
import '../styles/global.css';
import { getArticles } from '../lib/medium';

const articles = await getArticles(8);
const fmt = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' });

const experience = [
  {
    when: '2023 – Now',
    role: 'Senior Web Application Developer',
    org: 'King Power',
    what: 'Leading frontend for membership and e-commerce platforms: architecture on a shared design system, code reviews and mentoring.',
  },
  {
    when: '2018 – 2023',
    role: 'Senior Officer, Web Application',
    org: 'King Power Click',
    what: 'Built large-scale web applications, introduced TypeScript and led the move from legacy systems to a modern React architecture.',
  },
  {
    when: '2016 – 2018',
    role: 'Junior Software Engineer',
    org: 'Intelligent Byte',
    what: 'Developed high-traffic booking interfaces with React and Redux, with a focus on performance for international markets.',
  },
  {
    when: '2017 – 2019',
    role: 'B.Sc. Information Technology',
    org: 'Rajamangala University of Technology Suvarnabhumi',
    what: 'Faculty of Science and Technology.',
  },
];

const statement =
  'Great code isn’t just fast. It’s clear, reusable, and helps the entire team grow.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Thiraphat Phutson — Senior Frontend Engineer</title>
    <meta
      name="description"
      content="Senior frontend engineer in Bangkok building scalable, accessible web platforms with React, Next.js and TypeScript."
    />
    <link rel="canonical" href="https://thiraphat-ps-dev.github.io/" />
    <meta name="theme-color" content="#0b0d10" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://thiraphat-ps-dev.github.io/" />
    <meta property="og:title" content="Thiraphat Phutson — Senior Frontend Engineer" />
    <meta
      property="og:description"
      content="Scalable, accessible interfaces, and the design systems and teams behind them."
    />
    <meta property="og:image" content="https://thiraphat-ps-dev.github.io/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="nav">
      <nav class="container nav-inner" aria-label="Main">
        <a class="nav-brand" href="/">Thiraphat</a>
        <ul class="nav-links">
          <li><a href="#work">Work</a></li>
          <li><a href="#thira-ui">thira-ui</a></li>
          <li><a href="#writing">Writing</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-inner">
          <p class="eyebrow">Senior Frontend Engineer · Bangkok</p>
          <h1 id="hero-title" class="headline">
            Code that <span class="grad">lasts.</span>
          </h1>
          <p class="lede">
            I build scalable, accessible interfaces, and the design systems and teams behind them.
          </p>
          <HeroCta />
        </div>
        <span class="scroll-hint" aria-hidden="true">Scroll ↓</span>
      </section>

      <section class="explode" aria-labelledby="explode-title">
        <div class="explode-sticky">
          <div class="container explode-copy">
            <p class="eyebrow">How I build interfaces</p>
            <h2 id="explode-title" class="section-title small">Three layers.<br />One system.</h2>
          </div>
          <div class="explode-stage">
            <ExplodedStack />
            <ol class="explode-labels">
              <li class="lbl lbl-components"><b>Components</b> Accessible, composable, ready to ship.</li>
              <li class="lbl lbl-primitives"><b>Primitives</b> Behavior and ARIA from headless foundations.</li>
              <li class="lbl lbl-tokens"><b>Tokens</b> Color, space and type as CSS variables.</li>
            </ol>
          </div>
        </div>
      </section>

      <section class="statement" aria-label="Philosophy">
        <p class="container">
          {statement.split(' ').map((word) => <span class="w">{word} </span>)}
        </p>
      </section>

      <section class="spectrum" aria-labelledby="spectrum-title">
        <div class="spectrum-sticky" data-thira-theme>
          <div class="container spectrum-inner">
            <div class="spectrum-copy">
              <h2 id="spectrum-title" class="section-title">
                One variable.<br /><span class="grad">Every color.</span>
              </h2>
              <p class="lede">
                Scroll, and a single CSS variable re-themes every accent, hover and focus ring in
                thira-ui. No JavaScript involved.
              </p>
              <code class="hue-readout">--thira-hue</code>
            </div>
            <ThiraUiDemo />
          </div>
        </div>
      </section>

      <section id="work" class="work" aria-labelledby="work-title">
        <div class="container">
          <h2 id="work-title" class="section-label">Selected work</h2>
          <article id="thira-ui" class="tile tile-feature">
            <div>
              <p class="kicker">Open source · React UI library</p>
              <h2>thira-ui</h2>
              <p class="desc">
                An accessible component library built on Base UI primitives and modern CSS:
                <code>oklch()</code> tokens, <code>@layer</code> and zero CSS-in-JS. Every component
                is checked with axe in light and dark mode.
              </p>
              <label class="hue">
                <span>Try the theme. Drag to change <code>--thira-hue</code></span>
                <input type="range" min="0" max="360" value="250" data-hue-slider />
              </label>
              <div class="links">
                <a href="https://thiraphat-ps-dev.github.io/thira-ui/">Live Storybook ↗</a>
                <a href="https://github.com/thiraphat-ps-dev/thira-ui">Source on GitHub ↗</a>
              </div>
            </div>
            <pre class="code-panel" aria-label="Usage example"><code><span class="k">import</span> {'{'} Button, Dialog {'}'} <span class="k">from</span> <span class="s">'thira-ui'</span>;

&lt;<span class="t">Dialog</span>&gt;
  &lt;<span class="t">Dialog.Trigger</span> render={'{'}&lt;<span class="t">Button</span> /&gt;{'}'}&gt;
    Open
  &lt;/<span class="t">Dialog.Trigger</span>&gt;
  &lt;<span class="t">Dialog.Content</span> title=<span class="s">"Hello"</span>&gt;
    Focus is trapped. Esc closes.
  &lt;/<span class="t">Dialog.Content</span>&gt;
&lt;/<span class="t">Dialog</span>&gt;</code></pre>
          </article>

          <article class="tile">
            <div>
              <p class="kicker">King Power · 2023 – Present</p>
              <h2>Membership &amp; commerce platforms</h2>
              <p class="desc">
                I lead frontend development on King Power's membership platform and e-commerce
                experiences. That covers the component architecture on a shared design system, form
                and data patterns with React Hook Form and React Query, plus code reviews and
                mentoring for the team.
              </p>
              <ul class="tags" aria-label="Tech stack">
                <li>Next.js</li>
                <li>TypeScript</li>
                <li>React Query</li>
                <li>Design Tokens</li>
                <li>Storybook</li>
              </ul>
            </div>
            <div class="planes" aria-hidden="true">
              <div class="plane p1"></div>
              <div class="plane p2"></div>
              <div class="plane p3"></div>
            </div>
          </article>
        </div>
      </section>

      <section id="experience" class="exp" aria-labelledby="exp-title">
        <div class="container exp-inner">
          <div class="exp-head">
            <p class="eyebrow">Experience</p>
            <h2 id="exp-title" class="section-title small">Shipping for real users since 2016.</h2>
          </div>
          <ol class="timeline">
            {
              experience.map((job) => (
                <li class="job">
                  <span class="when">{job.when}</span>
                  <div>
                    <h3>{job.role}</h3>
                    <p class="org">{job.org}</p>
                    <p class="what">{job.what}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="bento-wrap" aria-labelledby="bento-title">
        <div class="container">
          <p class="eyebrow">What I bring</p>
          <h2 id="bento-title" class="section-title small">More than shipping screens.</h2>
          <div class="bento">
            <div class="cell cell-years">
              <span class="big">6+</span>
              <span class="cap">years building production web apps</span>
            </div>
            <div class="cell cell-stack">
              <span class="cap">Daily stack</span>
              <ul class="stack-list">
                <li>React</li><li>Next.js</li><li>TypeScript</li><li>React Query</li><li>Storybook</li><li>Vitest</li>
              </ul>
            </div>
            <div class="cell cell-a11y">
              <span class="big">AA</span>
              <span class="cap">Accessibility is a default, checked with axe, not an afterthought</span>
            </div>
            <div class="cell cell-mentor">
              <span class="ico" aria-hidden="true">◎</span>
              <h3>Mentoring &amp; reviews</h3>
              <p>Growing junior and mid-level developers through code review and pairing.</p>
            </div>
            <div class="cell cell-ds">
              <span class="ico" aria-hidden="true">◇</span>
              <h3>Design systems</h3>
              <p>Tokens, theming and Storybook that keep large teams consistent.</p>
            </div>
            <div class="cell cell-ai">
              <span class="ico" aria-hidden="true">✦</span>
              <h3>AI-native workflow</h3>
              <p>Agentic pipelines that scaffold, test and self-check code against quality gates.</p>
            </div>
          </div>
        </div>
      </section>

      {
        articles.length > 0 && (
          <section id="writing" class="writing" aria-labelledby="writing-title">
            <div class="container writing-head">
              <h2 id="writing-title" class="section-title small">Writing</h2>
              <a class="more" href="https://medium.com/@thiraphat-ps-dev">
                All articles on Medium ↗
              </a>
            </div>
            <ul class="rail">
              {articles.map((a) => (
                <li class="post">
                  <a href={a.url} lang={a.lang}>
                    <div class="thumb">
                      {a.image && <img src={a.image} alt="" loading="lazy" decoding="async" />}
                    </div>
                    <time datetime={a.date.toISOString()}>{fmt.format(a.date)}</time>
                    <h3>{a.title}</h3>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="outro" aria-labelledby="outro-title">
        <div class="outro-sticky">
          <h2 id="outro-title" class="outro-text">
            Let’s build something that <span class="o-zoom">lasts</span>.
          </h2>
        </div>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-title">
        <div class="container contact-inner">
          <h2 id="contact-title" class="section-title">Say hello.</h2>
          <p class="lede">Open to conversations about frontend, design systems and teams.</p>
          <ul class="contact-links">
            <li><a href="mailto:thiraphat.ps.dev@gmail.com">Email</a></li>
            <li><a href="https://www.linkedin.com/in/thiraphat-phutson/">LinkedIn</a></li>
            <li><a href="https://github.com/thiraphat-ps-dev">GitHub</a></li>
            <li><a href="https://medium.com/@thiraphat-ps-dev">Medium</a></li>
          </ul>
        </div>
        <footer class="container foot">
          <span>© {new Date().getFullYear()} Thiraphat Phutson</span>
          <span>Built with Astro and <a href="https://github.com/thiraphat-ps-dev/thira-ui">thira-ui</a>. Zero CSS-in-JS.</span>
        </footer>
      </section>
    </main>

    <script>
      // The only JS on the page: a hue slider that re-themes everything live.
      const slider = document.querySelector<HTMLInputElement>('[data-hue-slider]');
      slider?.addEventListener('input', () => {
        document.documentElement.style.setProperty('--thira-hue', slider.value);
      });
    </script>
  </body>
</html>
